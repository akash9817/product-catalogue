# Copy to .env to override defaults. Nothing here is a secret, and every value
# has a working default, so the app runs without a .env file.
#
# docker compose reads this file for variable substitution.
# Local dev (npm run dev) reads these from the process environment.

# Product data source (behind the ProductSource interface)
FAKESTORE_BASE_URL=https://fakestoreapi.com
CACHE_TTL_MS=300000

# Backend
CORS_ORIGIN=http://localhost:8080

# Email (SMTP). Mailpit captures everything locally at http://localhost:8025
SMTP_FROM=Catalogue <no-reply@catalogue.local>
SALES_INBOX=sales@catalogue.local
